# ── AgentRouter (REQUIRED) ────────────────────────────────────────────────────
# Get your key at: https://agentrouter.org/console/token
AGENTROUTER_API_KEY=your_agentrouter_api_key_here

# ── AI Model ──────────────────────────────────────────────────────────────────
# Find available models in your AgentRouter dashboard.
# claude-sonnet-4-5-20250929 is a reliable Claude model on AgentRouter.
AI_MODEL=claude-sonnet-4-5-20250929

# ── ASP Branding ──────────────────────────────────────────────────────────────
# These are displayed on the OKX AI marketplace listing.
ASP_NAME=Claude AI Research & Writing ASP
ASP_DESC=AI-powered deep research, technical writing, market analysis, and SQL generation. Backed by Claude.

# ── Server Port (Render sets this automatically) ───────────────────────────────
PORT=3000
